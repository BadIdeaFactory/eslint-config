{
	"name": "@biffud/eslint-config",
	"version": "0.0.0",
	"description": "Expertly implemented eslint configurations for overengineered projects",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "npm run cleanup && npm run build:node",
		"build:node": "tsc -p tsconfig.json",
		"cleanup": "rimraf dist",
		"format": "npm run format:eslint && npm run format:prettier",
		"format:eslint": "eslint . --fix || true",
		"format:prettier": "prettier . --write",
		"lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:tsc",
		"lint:commit": "commitlint --from origin/main --to HEAD --verbose",
		"lint:eslint": "eslint . --max-warnings=0",
		"lint:prettier": "prettier . --check",
		"lint:tsc": "tsc --noEmit -p tsconfig.dev.json",
		"test": "node --test \"src/**/*.test.ts\""
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/BadIdeaFactory/eslint-config.git"
	},
	"bugs": {
		"url": "https://github.com/BadIdeaFactory/eslint-config/issues"
	},
	"homepage": "https://github.com/BadIdeaFactory/eslint-config#readme",
	"keywords": [
		"eslint",
		"eslintconfig",
		"eslint-config",
		"typescript",
		"linting"
	],
	"author": {
		"name": "Daniel Schultz",
		"email": "slifty@gmail.com",
		"url": "https://github.com/slifty"
	},
	"license": "AGPL-3.0",
	"peerDependencies": {
		"eslint": "^10.0.0"
	},
	"dependencies": {
		"typescript-eslint": "^8.68.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/js": "^10.0.1",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.13.3",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"globals": "^17.11.0",
		"prettier": "3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3"
	}
}
